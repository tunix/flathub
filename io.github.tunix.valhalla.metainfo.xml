  <name>Valhalla</name>
  <summary>Theme-aware wallpaper switcher</summary>
  <description>
    <p>A minimal wallpaper application that selects wallpapers from online sources and matches them to your desktop's light or dark appearance, so dark mode never gets a blinding white wallpaper.</p>
  </description>
  <launchable type="desktop-id">io.github.tunix.valhalla.desktop</launchable>
  <url type="homepage">https://github.com/tunix/valhalla</url>
  <url type="bugtracker">https://github.com/tunix/valhalla/issues</url>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/tunix/valhalla/main/docs/screenshots/dark.png</image>
